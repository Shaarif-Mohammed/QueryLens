# QueryLens — AI-Powered Marketplace Analytics Copilot
# Environment settings template
#
# Copy this file to .env and fill in real values. .env is gitignored; never commit real values.

# --- LLM: Google Gemini ---
# Vertex AI (recommended): billed to a Google Cloud project, authenticated with a
# service account that has the "Vertex AI User" role. Keep the JSON key file
# outside the repository.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# Main model, then backup models tried in order if it is overloaded or unavailable
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash

# Thinking budget (tokens) for the explanation step; a small budget keeps it fast
GEMINI_EXPLANATION_THINKING_BUDGET=256

# --- Database (read-only role) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=querylens_readonly
DB_PASSWORD=your-database-password
DB_SCHEMA=warehouse

# --- App behavior ---
LIVE_QUESTION_SESSION_CAP=18
